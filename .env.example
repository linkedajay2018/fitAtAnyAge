# Copy this file to .env and fill in your own values.
# Every setting below has a working default in config.py — .env only needs
# to override what's different for your deployment.

# --- Site branding & SEO -------------------------------------------------
# Shown in the nav, page titles, footer, and meta tags used by search
# engines and social previews (Open Graph/Twitter cards, JSON-LD).
SITE_NAME=FitAtAnyAge
SITE_TAGLINE=Strength and mobility training for every decade — 20s to 70s
SITE_DESCRIPTION=Workout plans, safety tips, and tools tailored to your age, from your 20s through your 70s.
CONTACT_EMAIL=hello@example.com
COPYRIGHT_YEAR=2026

# The site's real public URL once deployed (e.g. https://fitatanyage.com).
# Used to build canonical links, Open Graph URLs, sitemap.xml/robots.txt
# entries, and Stripe's success/cancel redirect URLs. Must match the host
# the app is actually reachable on, protocol included, no trailing slash.
DOMAIN=http://127.0.0.1:5050

# Marketing copy for the Premium price shown on the Membership page. The
# amount actually billed is defined by STRIPE_PRICE_ID / UPI_AMOUNT below —
# keep this in sync if you change either.
PREMIUM_PRICE_LABEL=$19.99 / month

# --- Flask / server -------------------------------------------------
# Secret key Flask uses to sign session cookies. Set this to a long random
# value for any real deployment — the fallback is fine for local dev only.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port the app listens on locally (python app.py) and inside Docker.
PORT=5050

# Flask debug mode (auto-reload, interactive debugger). Keep true for local
# dev; the Docker image ignores this and always runs gunicorn (production).
FLASK_DEBUG=true

# Overrides the default SQLite file (instance/fitafter40.db) — set this to
# point at Postgres/MySQL etc. for a real deployment, e.g.
# postgresql://user:pass@host:5432/fitafter40
# DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# Comma-separated emails that get admin access (a protected /admin page for
# manually confirming UPI payments). Applied when that email signs up or
# logs in — no manual DB edit needed.
ADMIN_EMAILS=you@example.com

# --- Email (password reset / verification) ---------------------------------
# Standard SMTP — works with Gmail, Amazon SES, Mailgun's SMTP endpoint, etc.
# Without these set, outgoing emails print to the console instead of being
# sent, so password reset and email verification are fully testable with
# zero setup.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-smtp-password-or-app-password
# MAIL_DEFAULT_SENDER=you@example.com

# --- Rate limiting -----------------------------------------------------
# Flask-Limiter storage. "memory://" (default) is per-process — fine for a
# single dev/gunicorn-worker deployment. Point this at Redis for a real
# multi-worker deployment so limits are shared across workers.
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# --- Security headers --------------------------------------------------
# Forces HTTPS + HSTS via flask-talisman. Keep false for local http:// dev;
# set true once actually deployed behind HTTPS.
# FORCE_HTTPS=false

# --- SSO login (Google / Facebook) -----------------------------------------
# Both optional and independent — the "Continue with X" button only shows
# up once that provider's two values below are both set. Leave unset and
# the site works exactly as before (email/password only).
#
# Google: create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# (Application type: Web application). Add this as an Authorized redirect URI
# (must match DOMAIN above exactly, including port):
#   http://127.0.0.1:5050/login/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Facebook: create an app at https://developers.facebook.com/apps/, add the
# "Facebook Login" product, and add this as a Valid OAuth Redirect URI:
#   http://127.0.0.1:5050/login/facebook/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# --- Stripe (test mode) ---------------------------------------------------
# Copy this file to .env and fill in your Stripe TEST mode keys.
# Get these from https://dashboard.stripe.com/test/apikeys and
# https://dashboard.stripe.com/test/products (create a recurring Price there).
STRIPE_SECRET_KEY=<your-stripe-test-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-test-publishable-key>
STRIPE_PRICE_ID=<your-stripe-recurring-price-id>

# --- UPI (India) ---------------------------------------------------------
# Your own UPI ID (VPA), e.g. from any UPI app tied to your bank account or
# business account. Generates a scan-to-pay QR code.
UPI_VPA=yourname@upi
UPI_PAYEE_NAME=FitAtAnyAge
UPI_AMOUNT=999

# --- Tracing (OpenTelemetry) -----------------------------------------------
# On by default. Set to false to disable entirely.
ENABLE_TRACING=true

# Where to send traces. Leave unset to print spans to the console.
# When running via `docker compose up`, this is set automatically to the
# bundled Jaeger container — view traces at http://localhost:16686.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Chatbot ---------------------------------------------------------------
# The chat widget works with zero setup — it answers from a built-in FAQ
# (content.py's CHATBOT_FAQ) when this is unset. Set an API key here to
# upgrade it to real AI-generated answers via Claude, grounded in this
# site's own workout/diet content. Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_MODEL=claude-sonnet-4-5
