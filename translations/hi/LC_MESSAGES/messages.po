#: app.py:117
msgid "Please log in to continue."
msgstr "कृपया जारी रखने के लिए लॉग इन करें।"

#: app.py:176
msgid "Enter a valid height and weight."
msgstr "सही ऊंचाई और वज़न दर्ज करें।"

#: app.py:177
#, python-format
msgid "Your BMI is %(bmi)s (%(category)s)"
msgstr "आपका BMI %(bmi)s है (%(category)s)"

#: app.py:178
#, python-format
msgid "Your BMI is %(bmi)s (%(category)s). Estimated body fat: %(bodyfat)s%."
msgstr "आपका BMI %(bmi)s है (%(category)s)। अनुमानित बॉडी फैट: %(bodyfat)s%।"

#: app.py:179
msgid "Underweight"
msgstr "कम वज़न"

#: app.py:180
msgid "Healthy range"
msgstr "स्वस्थ सीमा"

#: app.py:181
msgid "Overweight"
msgstr "अधिक वज़न"

#: app.py:182
msgid "Obese"
msgstr "मोटापा"

#: app.py:183
msgid "Enter a valid age."
msgstr "सही उम्र दर्ज करें।"

#: app.py:185
#, python-format
msgid ""
"Estimated max heart rate: %(max)s bpm. Moderate zone: %(modLow)s–%(modHigh)s"
" bpm. Vigorous zone: %(vigLow)s–%(vigHigh)s bpm."
msgstr ""
"अनुमानित अधिकतम हृदय गति: %(max)s bpm। मध्यम ज़ोन: %(modLow)s–%(modHigh)s "
"bpm। तीव्र ज़ोन: %(vigLow)s–%(vigHigh)s bpm।"

#: app.py:188
msgid "Enter a valid height, weight, and age."
msgstr "सही ऊंचाई, वज़न, और उम्र दर्ज करें।"

#: app.py:189
#, python-format
msgid ""
"Estimated maintenance calories: %(tdee)s kcal/day (basal: %(bmr)s kcal/day)."
msgstr "अनुमानित रखरखाव कैलोरी: %(tdee)s kcal/दिन (बेसल: %(bmr)s kcal/दिन)।"

#: app.py:190
msgid "Enter a valid weight and reps (1–15)."
msgstr "सही वज़न और रेप्स (1–15) दर्ज करें।"

#: app.py:191
#, python-format
msgid "Estimated one-rep max: %(orm)s kg"
msgstr "अनुमानित वन-रेप मैक्स: %(orm)s किलो"

#: app.py:192
#, python-format
msgid "Estimated one-rep max: %(orm)s lb"
msgstr "अनुमानित वन-रेप मैक्स: %(orm)s पाउंड"

#: app.py:193
msgid "Percent of 1RM"
msgstr "1RM का प्रतिशत"

#: app.py:194 templates/tools.html:33 templates/tools.html:85
msgid "Weight (kg)"
msgstr "वज़न (किलो)"

#: app.py:195 templates/tools.html:27 templates/tools.html:79
msgid "Weight (lb)"
msgstr "वज़न (पाउंड)"

#: app.py:196
msgid "Enter a valid waist and hip measurement."
msgstr "सही कमर और कूल्हे का माप दर्ज करें।"

#: app.py:197
#, python-format
msgid "Waist-to-hip ratio: %(ratio)s"
msgstr "कमर-से-कूल्हे अनुपात: %(ratio)s"

#: app.py:198
#, python-format
msgid "Waist-to-hip ratio: %(ratio)s (%(risk)s risk)"
msgstr "कमर-से-कूल्हे अनुपात: %(ratio)s (%(risk)s जोखिम)"

#: app.py:199
msgid "low"
msgstr "कम"

#: app.py:200
msgid "moderate"
msgstr "मध्यम"

#: app.py:201
msgid "high"
msgstr "ज़्यादा"

#: app.py:202
#, python-format
msgid "In your %(age)s — %(headline)s. %(blurb)s"
msgstr "%(age)s की उम्र में — %(headline)s। %(blurb)s"

#: app.py:203
msgid "Something went wrong — please try again."
msgstr "कुछ गड़बड़ हो गई — कृपया फिर से कोशिश करें।"

#: app.py:204
msgid "Sorry, I couldn't process that."
msgstr "माफ़ करें, मैं इसे समझ नहीं पाया।"

#: app.py:392 chatbot.py:20
msgid "Ask me something about training, diet, or hydration!"
msgstr "मुझसे ट्रेनिंग, डाइट, या हाइड्रेशन के बारे में कुछ पूछें!"

#: app.py:447
msgid "Payments aren't configured yet. See .env.example for Stripe setup."
msgstr ""
"भुगतान अभी सेट नहीं किया गया है। Stripe सेटअप के लिए .env.example देखें।"

#: app.py:465
#, python-format
msgid "Could not start checkout: %(error)s"
msgstr "चेकआउट शुरू नहीं हो सका: %(error)s"

#: app.py:509 app.py:754 app.py:916
msgid "Enter a valid email address."
msgstr "सही ईमेल पता दर्ज करें।"

#: app.py:511 app.py:587 app.py:777
msgid "Password must be at least 8 characters."
msgstr "पासवर्ड कम से कम 8 अक्षरों का होना चाहिए।"

#: app.py:513 app.py:758
msgid "An account with that email already exists."
msgstr "इस ईमेल से पहले से एक खाता मौजूद है।"

#: app.py:521
#, python-format
msgid "Welcome to %(site_name)s!"
msgstr "%(site_name)s में आपका स्वागत है!"

#: app.py:522
#, python-format
msgid "We've sent a verification link to %(email)s."
msgstr "हमने %(email)s पर एक सत्यापन लिंक भेज दिया है।"

#: app.py:544
msgid "Logged in."
msgstr "लॉग इन हो गया।"

#: app.py:547
msgid "Invalid email or password."
msgstr "गलत ईमेल या पासवर्ड।"

#: app.py:567
msgid "If an account exists for that email, we've sent a password reset link."
msgstr ""
"अगर उस ईमेल से कोई खाता मौजूद है, तो हमने एक पासवर्ड रीसेट लिंक भेज दिया है।"

#: app.py:581
msgid "That password reset link is invalid or has expired. Request a new one."
msgstr ""
"यह पासवर्ड रीसेट लिंक अमान्य है या समय सीमा समाप्त हो गई है। नया लिंक "
"मंगाएं।"

#: app.py:594
msgid "Your password has been reset. Log in with your new password."
msgstr "आपका पासवर्ड रीसेट कर दिया गया है। अपने नए पासवर्ड से लॉग इन करें।"

#: app.py:604
msgid "That verification link is invalid or has expired."
msgstr "यह सत्यापन लिंक अमान्य है या समय सीमा समाप्त हो गई है।"

#: app.py:613
msgid "Your email has been verified — thanks!"
msgstr "आपका ईमेल सत्यापित हो गया है — धन्यवाद!"

#: app.py:622
msgid "Your email is already verified."
msgstr "आपका ईमेल पहले से सत्यापित है।"

#: app.py:625
#, python-format
msgid "We've sent a new verification link to %(email)s."
msgstr "हमने %(email)s पर एक नया सत्यापन लिंक भेज दिया है।"

#: app.py:686
msgid "Something went wrong signing you in — please try again."
msgstr "लॉग इन करने में समस्या हुई — कृपया फिर से कोशिश करें।"

#: app.py:693
#, python-format
msgid ""
"We couldn't get an email address from your %(provider)s account. Make sure "
"your account has a verified email, or use email/password instead."
msgstr ""
"हम आपके %(provider)s खाते से ईमेल पता प्राप्त नहीं कर सके। सुनिश्चित करें कि"
" आपके खाते में सत्यापित ईमेल है, या इसके बजाय ईमेल/पासवर्ड का उपयोग करें।"

#: app.py:705
#, python-format
msgid "Logged in with %(provider)s."
msgstr "%(provider)s से लॉग इन किया गया।"

#: app.py:714
msgid "Logged out."
msgstr "लॉग आउट हो गया।"

#: app.py:756 app.py:775 app.py:809
msgid "Current password is incorrect."
msgstr "मौजूदा पासवर्ड गलत है।"

#: app.py:764
#, python-format
msgid "Email updated. We've sent a verification link to %(email)s."
msgstr "ईमेल अपडेट किया गया। हमने %(email)s पर एक सत्यापन लिंक भेज दिया है।"

#: app.py:781
msgid "Password updated."
msgstr "पासवर्ड अपडेट किया गया।"

#: app.py:791
msgid "Set a password first so you can still log in after disconnecting."
msgstr ""
"डिस्कनेक्ट करने के बाद भी लॉग इन कर सकें, इसके लिए पहले एक पासवर्ड सेट करें।"

#: app.py:795
msgid "Disconnected."
msgstr "डिस्कनेक्ट कर दिया गया।"

#: app.py:806
msgid "Type your email address exactly to confirm deletion."
msgstr "हटाने की पुष्टि के लिए अपना ईमेल पता बिल्कुल सही टाइप करें।"

#: app.py:817
msgid "Your account has been deleted."
msgstr "आपका खाता हटा दिया गया है।"

#: app.py:873
#, python-format
msgid "Updated %(email)s's membership."
msgstr "%(email)s की सदस्यता अपडेट की गई।"

#: app.py:903
msgid "Message deleted."
msgstr "संदेश हटा दिया गया।"

#: app.py:914
msgid "Please fill in both your name and message."
msgstr "कृपया अपना नाम और संदेश दोनों भरें।"

#: app.py:920
#, python-format
msgid "Thanks %(name)s, we received your message!"
msgstr "धन्यवाद %(name)s, हमें आपका संदेश मिल गया है!"

#: chatbot.py:38
msgid ""
"I don't have a specific answer for that one — try browsing Workout Plans, "
"Diet Plan, or Safety Tips, or send us a message via Contact and we'll help "
"directly."
msgstr ""
"इसका कोई खास जवाब मेरे पास नहीं है — Workout Plans, Diet Plan, या Safety "
"Tips देखें, या Contact के ज़रिए हमें संदेश भेजें, हम सीधे मदद करेंगे।"

#: content.py:45
