#: templates/tools.html:121
msgid "e.g. 135"
msgstr "जैसे 135"

#: templates/tools.html:123
msgid "Weight Lifted (kg)"
msgstr "उठाया गया वज़न (किलो)"

#: templates/tools.html:124
